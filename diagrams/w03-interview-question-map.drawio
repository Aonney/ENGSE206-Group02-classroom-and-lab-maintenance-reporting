      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E67E22;strokeColor=none;align=left;spacingLeft=20;" value="&lt;font style=&quot;font-size: 16px;&quot; color=&quot;#ffffff&quot;&gt;&lt;b&gt;Classroom &amp;amp; Lab Maintenance — Interview Question Map&amp;nbsp;&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="770" x="40" y="40" as="geometry" />
